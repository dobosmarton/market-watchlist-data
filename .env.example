# Copy to .env and fill in. Never commit .env.
WL_DATA_DIR=./data
WL_EXPORT_DIR=./exports
# SEC asks automated clients to identify themselves: "<name> <email>"
WL_SEC_USER_AGENT="watchlist-data your.name@example.com"
# Optional: Twelve Data API key for US quotes (free plan: 8 req/min, 800/day)
WL_TWELVEDATA_API_KEY=
# duckdb (default) or ducklake
WL_STORAGE=duckdb
